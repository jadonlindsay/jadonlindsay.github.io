---
import { getEntry } from 'astro:content';
import Photo from './Photo.astro';

// Shows every gallery item in the content file whose `section` matches.
const { section = 'main', small = false, wide = false, stack = false } = Astro.props;
const slug = Astro.params.slug as string;
const project = await getEntry('projects', slug);
const folder = project?.data.imageFolder ?? slug;
const items = (project?.data.gallery ?? []).filter((g) => g.section === section);
const cols = small ? 3 : Math.min(items.length, 3);
---
{items.length > 0 && (
  <div class:list={['gallery', { wide, stack }]} data-cols={cols}>
    {items.map((item) => (
      <figure>
        {item.placeholder || !item.src ? (
          <div class="soon" role="img" aria-label={`${item.caption ?? 'Photo'}, coming soon`}><span>Coming soon</span></div>
        ) : (
          <Photo {folder} file={item.src} alt={item.alt ?? ''} fit={item.fit} />
        )}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
