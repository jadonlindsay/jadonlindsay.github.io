---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import site from '../../site.config.json';
import { Content as About } from '../content/about.md';
// Line-figure thumbnails for the cards, drawn with Hairline (sources in hairline/).
import rover from '../figures/rover.svg?raw';
import linkage from '../figures/linkage.svg?raw';
import labor from '../figures/labor.svg?raw';
import weld from '../figures/weld-map.svg?raw';
import trouble from '../figures/trouble.svg?raw';
const figs: Record<string, { svg: string; no: string; name: string }> = {
  'triphibian-rover': { svg: rover, no: 'FIG 01', name: 'CHASSIS' },
  'linkage-toy': { svg: linkage, no: 'FIG 02', name: 'DIORAMA' },
  'labor-reporting-tool': { svg: labor, no: 'FIG 03', name: 'HOURS / WEEK' },
  'dynamic-systems': { svg: weld, no: 'FIG 04', name: 'WELD MAP' },
  'trouble-game': { svg: trouble, no: 'FIG 05', name: 'BOARD' },
};

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const work = all.filter((p) => p.data.group === 'work' && p.data.featured);
const [lead, ...rest] = work;
const leadership = all.filter((p) => p.data.group === 'leadership' && p.data.featured);
const other = all.filter((p) => p.data.group === 'other' && p.data.featured);
const hrefOf = (p: (typeof all)[number]) => p.data.link ?? `/${p.id}/`;
const folderOf = (p: (typeof all)[number]) => p.data.imageFolder ?? p.id;
---
<Base current="home">
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>{site.headline}</h1>
      <p class="lede">{site.subline}</p>
      <p class="meta">{site.meta.split(' · ').map((part, i) => <>{i > 0 && ' · '}{part.includes('GPA') ? <span class="gpa">{part}</span> : part}</>)}</p>
      <div class="actions">
        <a class="btn" href={site.resume} target="_blank" rel="noopener">Resume (PDF)</a>
        <a class="btn btn-plain" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-plain" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
    <div class="hero-pic carousel" data-carousel aria-roledescription="carousel" aria-label="Photos of Jadon">
      <div class="slides">
        <div class="slide is-on" aria-roledescription="slide" aria-label="1 of 3">
          <Photo folder="home" file="headshot.jpg" alt="Portrait of Jadon Lindsay in a navy suit" ratio="4 / 5" sizes="(max-width: 700px) 70vw, 360px" eager />
        </div>
        <div class="slide" aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true">
          <Photo folder="home" file="semiconductor-summit.jpg" alt="Jadon Lindsay giving a thumbs up in front of the Texas Semiconductor Summit backdrop" ratio="4 / 5" sizes="(max-width: 700px) 70vw, 360px" position="40% 50%" />
        </div>
        <div class="slide" aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true">
          <Photo folder="home" file="team-assembling.jpg" alt="Three TriPhi team members in safety glasses fitting prop motors onto the rover's frame tubes" ratio="4 / 5" sizes="(max-width: 700px) 70vw, 360px" position="50% 40%" />
        </div>
      </div>
      <div class="dots">
        <button type="button" aria-label="Show photo 1" aria-pressed="true"></button>
        <button type="button" aria-label="Show photo 2" aria-pressed="false"></button>
        <button type="button" aria-label="Show photo 3" aria-pressed="false"></button>
      </div>
    </div>
  </section>

  <section class="band" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <h2 id="work-h">Featured work</h2>
      {lead && (
        <a class="card card-lead" href={hrefOf(lead)}>
          <div class="plate">
            <span class="fig-no">{figs[lead.id].no}</span><span class="fig-name">{figs[lead.id].name}</span>
            <Fragment set:html={figs[lead.id].svg} />
            <div class="plate-photo"><Photo folder={folderOf(lead)} file={lead.data.cardImage!} alt={lead.data.cardAlt ?? ''} fit={lead.data.cardFit} ratio="16 / 9" sizes="(max-width: 900px) 100vw, 700px" /></div>
          </div>
          <div class="card-text">
            <h3>{lead.data.title}</h3>
            {lead.data.tagline && <p class="lede">{lead.data.tagline}</p>}
            <p class="role">{lead.data.role}</p>
            <p class="metric">{lead.data.keyMetric}</p>
            <span class="go">Read the case study <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      )}
      <div class="cards">
        {rest.map((p) => (
          <a class="card" href={hrefOf(p)}>
            <div class="plate">
              <span class="fig-no">{figs[p.id].no}</span><span class="fig-name">{figs[p.id].name}</span>
              <Fragment set:html={figs[p.id].svg} />
              <div class="plate-photo"><Photo folder={folderOf(p)} file={p.data.cardImage!} alt={p.data.cardAlt ?? ''} fit={p.data.cardFit} ratio="16 / 9" sizes="(max-width: 700px) 100vw, 33vw" /></div>
            </div>
            <div class="card-text">
              <h3>{p.data.title}</h3>
              <p class="role">{p.data.role}</p>
              <p class="metric">{p.data.keyMetric}</p>
              <span class="go">{p.data.link ? 'See how it works' : 'Read the case study'} <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {leadership.map((p) => (
    <section class="band tone" id="leadership" aria-labelledby="leadership-h">
      <div class="wrap split">
        <div>
          <h2 id="leadership-h">Leadership</h2>
          <h3>{p.data.title}</h3>
          <p class="role">{p.data.role}</p>
          <p>{p.data.atAGlance}</p>
          <a class="go" href={hrefOf(p)}>Read about recruitment <span aria-hidden="true">&rarr;</span></a>
        </div>
        <Photo folder={folderOf(p)} file={p.data.cardImage!} alt={p.data.cardAlt ?? ''} ratio="16 / 9" sizes="(max-width: 900px) 100vw, 50vw" />
      </div>
    </section>
  ))}

  {other.length > 0 && (
    <section class="band" id="other" aria-labelledby="other-h">
      <div class="wrap">
        <h2 id="other-h">Other projects</h2>
        <div class="mini-list">
          {other.map((p) => (
            <div class="mini">
              <div class="plate plate-mini"><Fragment set:html={figs[p.id].svg} /></div>
              <div>
                <h3>{p.data.title}</h3>
                <p class="role">{p.data.role}</p>
                <p>{p.data.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band tone" id="about" aria-labelledby="about-h">
    <div class="wrap about">
      <h2 id="about-h">About</h2>
      <div class="prose"><About /></div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <h2 id="contact-h">Contact</h2>
      <a class="mail" href={`mailto:${site.email}`}>{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</a>
      <div class="actions">
        <a class="btn btn-light" href={`mailto:${site.email}`}>Email</a>
        <a class="btn btn-dark" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-dark" href={site.resume} target="_blank" rel="noopener">Resume (PDF)</a>
      </div>
    </div>
  </section>
</Base>


<script>
  // Hero carousel: crossfades every 5 s, pauses while pointed at or focused, stops for good once a dot is used.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    let at = 0, held = false, stopped = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (i: number) => {
      at = (i + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('is-on', k === at); s.setAttribute('aria-hidden', String(k !== at)); });
      dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === at)));
    };
    dots.forEach((d, k) => d.addEventListener('click', () => { stopped = true; show(k); }));
    root.addEventListener('pointerenter', () => { held = true; });
    root.addEventListener('pointerleave', () => { held = false; });
    root.addEventListener('focusin', () => { held = true; });
    root.addEventListener('focusout', () => { held = false; });
    setInterval(() => { if (!stopped && !held && !document.hidden) show(at + 1); }, 5000);
  });

  if (matchMedia('(hover: none)').matches) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('reveal', e.isIntersecting)),
      { rootMargin: '-40% 0px -40% 0px' },
    );
    document.querySelectorAll('.plate:has(.plate-photo)').forEach((el) => io.observe(el));
  }
</script>
